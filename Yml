
name: Build B & M Crochet House

on:
  push:
    branches: ["main"]
  pull_request:
    branches: ["main"]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: "npm"

      - name: Install dependencies
        run: npm install --no-audit --no-fund

      - name: Build Vite website
        run: npm run build

      - name: Upload production website
        uses: actions/upload-artifact@v4
        with:
          name: bm-crochet-house-web-build
          path: dist/
          if-no-files-found: error
          retention-days: 14
